DATABASE_URL="postgresql://postgres:password@localhost:5432/traveloop"
PORT=5001
JWT_SECRET=your_jwt_secret_key_change_in_production
# From Supabase Dashboard > Project Settings > API
# URL: https://<your-project-ref>.supabase.co
# service_role key: starts with eyJ... (do NOT expose this in the frontend)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CLOUDINARY_NAME=your_cloudinary_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
OPENWEATHER_API_KEY=your_openweather_api_key
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# Public URL the backend serves image URLs from (used for the photo proxy)
PUBLIC_BACKEND_URL=http://localhost:5001

# Geoapify Places & Geocoding API key (replaces Google Places)
GEOAPIFY_API_KEY=your_geoapify_api_key
